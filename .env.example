# Copy to .env.local; never commit credentials. scripts/astra-local.mjs can create local values.
APP_ORIGIN=http://127.0.0.1:3210
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
# 0: Gymaf connected entry. 1: original reference interface for isolated comparison only.
GYMAF_REFERENCE_PREVIEW=0
# Local inbox templates use code; hosted default Supabase emails use link.
GYMAF_EMAIL_AUTH_MODE=code
# No service-role key is used by the web application. Local seeding reads it in memory from the local CLI.

# Server-only Stripe test configuration; see astra/STRIPE_SETUP.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# At least 64 random characters; must match gymaf_private.billing_runtime.sync_secret.
GYMAF_BILLING_SYNC_SECRET=
# Live mode requires a separate explicit activation in BOTH environment and database.
GYMAF_STRIPE_LIVE_ENABLED=false
